+import { fireEvent, render, screen, waitFor, cleanup } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import HomepageTraderFeedback from './HomepageTraderFeedback';
+const { rpc } = vi.hoisted(() => ({ rpc: vi.fn() }));
+vi.mock('@/integrations/supabase/client', () => ({ supabase: { rpc } }));
+const review = { id: 'test-review', display_name: 'Test reviewer', trading_category: 'Demo', rating: 4, message: 'A test review supplied by the mocked approved endpoint.' };
+beforeEach(() => rpc.mockReset());
+afterEach(() => { cleanup(); vi.restoreAllMocks(); });
+describe('homepage feedback', () => {
+  it('shows loading then clearly labelled examples without invented ratings', async () => {
+    rpc.mockResolvedValue({ data: [], error: null });
+    render(<HomepageTraderFeedback />);
+    expect(screen.getByLabelText('Loading approved feedback')).toBeTruthy();
+    expect(await screen.findAllByText('Illustrative example · Not a review')).toHaveLength(6);
+    expect(screen.queryByRole('img', { name: /Rated/ })).toBeNull();
+  });
+  it('shows approved reviews and only their real ratings', async () => {
+    rpc.mockResolvedValue({ data: [review, { ...review, id: 'unrated', rating: null }], error: null });
+    render(<HomepageTraderFeedback />);
+    expect(await screen.findAllByText('Approved feedback')).toHaveLength(2);
+    expect(screen.getAllByRole('img', { name: /Rated/ })).toHaveLength(1);
+    expect(screen.queryByText('Illustrative example · Not a review')).toBeNull();
+    expect(rpc).toHaveBeenCalledWith('get_approved_trader_feedback');
+  });
+  it('handles errors and retries without presenting examples as reviews', async () => {
+    rpc.mockRejectedValueOnce(new Error('offline')).mockResolvedValue({ data: [review], error: null });
+    render(<HomepageTraderFeedback />);
+    expect(await screen.findByRole('alert')).toBeTruthy();
+    fireEvent.click(screen.getByRole('button', { name: 'Try again' }));
+    expect(await screen.findByText('Approved feedback')).toBeTruthy();
+    expect(screen.queryByRole('alert')).toBeNull();
+  });
+  it('replaces examples when approved feedback becomes available on focus', async () => {
+    rpc.mockResolvedValueOnce({ data: [], error: null }).mockResolvedValue({ data: [review], error: null });
+    render(<HomepageTraderFeedback />);
+    await screen.findAllByText('Illustrative example · Not a review');
+    fireEvent.focus(window);
+    expect(await screen.findByText('Approved feedback')).toBeTruthy();
+    expect(screen.queryByText('Illustrative example · Not a review')).toBeNull();
+  });
+  it('reports a failed submission and permits retry', async () => {
+    let now = 10000;
+    vi.spyOn(Date, 'now').mockImplementation(() => now);
+    rpc.mockImplementation((name: string) => name === 'get_approved_trader_feedback' ? Promise.resolve({ data: [], error: null }) : Promise.reject(new Error('offline')));
+    render(<HomepageTraderFeedback />);
+    fireEvent.click(screen.getByRole('button', { name: 'Share Your Feedback' }));
+    now += 3000;
+    fireEvent.change(screen.getByLabelText('First name or display name'), { target: { value: 'Demo' } });
+    fireEvent.change(screen.getByLabelText('Email (never shown publicly)'), { target: { value: 'demo@example.com' } });
+    fireEvent.change(screen.getByLabelText('Your feedback'), { target: { value: 'This is a test submission for the feedback form.' } });
+    fireEvent.click(screen.getByRole('button', { name: 'Submit feedback' }));
+    await waitFor(() => expect(screen.getByText('Your feedback could not be sent. Please try again.')).toBeTruthy());
+    expect(screen.queryByText('Thank you for your feedback.')).toBeNull();
+    rpc.mockResolvedValue({ data: { ok: true }, error: null });
+    fireEvent.click(screen.getByRole('button', { name: 'Submit feedback' }));
+    expect(await screen.findByText('It will be reviewed before anything is shown publicly.')).toBeTruthy();
+    expect(screen.queryByText('Approved feedback')).toBeNull();
+  });
+});
